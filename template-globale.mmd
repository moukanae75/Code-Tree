    style InfraLayer fill:#1e293b,stroke:#0284c7,stroke-width:2px,color:#fff
    style ServicesLayer fill:#111827,stroke:#10b981,stroke-width:2px,color:#fff
    style StorageLayer fill:#1e1b4b,stroke:#818cf8,stroke-width:2px,color:#fff
